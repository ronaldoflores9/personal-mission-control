# Copia este archivo a ".env" y llena los valores desde tu proyecto de Supabase
# (Project Settings -> API). Estas dos claves son seguras de exponer en el
# navegador: el acceso real a los datos lo protege Row Level Security.

PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key
