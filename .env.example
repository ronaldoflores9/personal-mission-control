# Copia este archivo a ".env" y llena los valores desde tu proyecto de Supabase
# (Project Settings -> API). Estas dos claves son seguras de exponer en el
# navegador: el acceso real a los datos lo protege Row Level Security.
PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
PUBLIC_SUPABASE_ANON_KEY=tu-anon-key

# Supabase service role key — Project Settings → API → service_role (SECRET, nunca exponer en el cliente)
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Resend — resend.com/api-keys
RESEND_API_KEY=re_...

# From address — debe ser un dominio verificado en Resend (usa onboarding@resend.dev para pruebas)
RESEND_FROM_EMAIL=onboarding@resend.dev

# URL pública del sitio (para el redirect del enlace mágico)
PUBLIC_SITE_URL=https://tu-dominio.com
