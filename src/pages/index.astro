---
import Layout from '../layouts/Layout.astro';
import MissionPatch from '../components/MissionPatch.astro';
---
<Layout title="Centro de mando" eyebrow="Bienvenida a bordo">
  <section class="hero">
    <div class="hero-text">
      <h1>Tu propio centro de mando.</h1>
      <p class="hero-sub">
        Entre clases, laboratorios y la cohetería, alguien tenía que construirte
        una torre de control. Aquí puedes organizar tus misiones, tu horario
        y tomarte un respiro — todo en un solo lugar, hecho para ti.
      </p>
      <div class="hero-actions">
        <a class="btn btn-flame" href="/board">Ver tablero de misión →</a>
        <a class="btn" href="/notes">Abrir paquete de apoyo 💌</a>
      </div>
    </div>
    <div class="hero-patch">
      <MissionPatch size={230} />
    </div>
  </section>

  <section class="readout panel" id="readout">
    <div class="readout-head">
      <span class="eyebrow">Próximas fechas</span>
      <a href="/schedule" class="mono readout-edit">ver todas →</a>
    </div>
    <div id="readout-body" class="readout-body">
      <p class="mono readout-empty">Sin fechas registradas. Agrégalas en Horario de vuelo.</p>
    </div>
  </section>

  <section class="grid">
    <a href="/board" class="card panel">
      <span class="eyebrow">Organización</span>
      <h3>Tablero de misión</h3>
      <p>Un scrumboard simple: Pre-vuelo, En vuelo y Aterrizado. Arrastra tus tareas o muévelas con un clic.</p>
    </a>
    <a href="/schedule" class="card panel">
      <span class="eyebrow">Semana</span>
      <h3>Horario de vuelo</h3>
      <p>Tu semana de clases, laboratorios y prácticas de cohetería, de un vistazo.</p>
    </a>
    <a href="/timer" class="card panel">
      <span class="eyebrow">Enfoque</span>
      <h3>Cuenta regresiva</h3>
      <p>Un temporizador de estudio estilo "T-menos" para sesiones de enfoque y descansos.</p>
    </a>
    <a href="/notes" class="card panel">
      <span class="eyebrow">Para ti</span>
      <h3>Paquete de apoyo</h3>
      <p>Notitas para los días difíciles — y espacio para que guardes las tuyas.</p>
    </a>
  </section>

  <script>
    import { getItem } from '../lib/store';

    type Deadline = { id: string; label: string; date: string; time?: string };
    const KEY = 'acm.deadlines';

    function daysUntil(dateStr: string) {
      const target = new Date(dateStr + 'T00:00:00').getTime();
      const today = new Date(); today.setHours(0,0,0,0);
      return Math.ceil((target - today.getTime()) / 86_400_000);
    }

    function badge(days: number) {
      if (days < 0)  return { text: `hace ${Math.abs(days)}d`, cls: 'past' };
      if (days === 0) return { text: '¡hoy!',    cls: 'today' };
      if (days === 1) return { text: 'mañana',   cls: 'soon' };
      if (days <= 7)  return { text: `en ${days} días`, cls: 'soon' };
      return           { text: `en ${days} días`, cls: 'future' };
    }

    async function render() {
      const body = document.getElementById('readout-body');
      if (!body) return;
      const all = await getItem<Deadline[]>(KEY, []);
      const upcoming = all
        .sort((a, b) => a.date.localeCompare(b.date))
        .slice(0, 4);

      if (upcoming.length === 0) {
        body.innerHTML = '<p class="mono readout-empty">Sin fechas registradas. Agrégalas en Horario de vuelo.</p>';
        return;
      }

      body.innerHTML = upcoming.map(d => {
        const days = daysUntil(d.date);
        const { text, cls } = badge(days);
        const time = d.time ? ` · ${d.time}` : '';
        return `
          <div class="dl-row">
            <div class="dl-info">
              <span class="dl-name">${d.label}</span>
              <span class="mono dl-date">${d.date}${time}</span>
            </div>
            <span class="dl-badge dl-badge--${cls}">${text}</span>
          </div>`;
      }).join('');
    }

    render();
    window.addEventListener('acm:auth', (e) => {
      if ((e as CustomEvent).detail?.authenticated) render();
    });
  </script>

  <style>
    .hero {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 32px;
      padding: 40px 0 32px;
      flex-wrap: wrap;
    }
    .hero-text { flex: 1 1 380px; }
    .hero h1 {
      font-size: clamp(1.9rem, 4vw, 2.6rem);
      margin-bottom: 16px;
    }
    .hero-sub {
      color: var(--ink-dim);
      max-width: 46ch;
      margin-bottom: 24px;
    }
    .hero-actions { display: flex; gap: 12px; flex-wrap: wrap; }
    @media (max-width: 480px) {
      .hero-actions { flex-direction: column; }
      .hero-actions .btn { text-align: center; }
    }
    .hero-patch { flex: 0 0 auto; }
    @media (max-width: 480px) { .hero-patch { display: none; } }

    .readout { padding: 20px 24px; margin-bottom: 32px; }
    .readout-head {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 14px;
    }
    .readout-edit { font-size: 0.72rem; color: var(--ink-dim); text-decoration: none; }
    .readout-edit:hover { color: var(--telemetry); }
    .readout-body { display: flex; flex-direction: column; gap: 10px; }
    .readout-empty { color: var(--ink-dim); font-size: 0.85rem; }

    :global(.dl-row) {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--panel-line);
    }
    :global(.dl-row:last-child) { border-bottom: none; padding-bottom: 0; }
    :global(.dl-info) { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
    :global(.dl-name) { font-size: 0.95rem; font-weight: 600; color: var(--ink); }
    :global(.dl-date) { font-size: 0.72rem; color: var(--ink-dim); }
    :global(.dl-badge) { font-family: var(--font-mono); font-size: 0.7rem; padding: 3px 10px; border-radius: 999px; white-space: nowrap; }
    :global(.dl-badge--today) { background: rgba(255,107,53,0.15); color: var(--flame); }
    :global(.dl-badge--soon)  { background: rgba(230,180,0,0.12);  color: #e6b400; }
    :global(.dl-badge--future){ background: rgba(95,212,208,0.1);  color: var(--telemetry); }
    :global(.dl-badge--past)  { background: var(--void-2); color: var(--ink-dim); }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }
    .card {
      padding: 20px;
      text-decoration: none;
      color: var(--ink);
      display: flex;
      flex-direction: column;
      gap: 8px;
      transition: border-color 0.15s ease, transform 0.15s ease;
    }
    .card:hover { border-color: var(--telemetry); transform: translateY(-2px); }
    .card h3 { font-size: 1.05rem; }
    .card p { color: var(--ink-dim); font-size: 0.85rem; }
  </style>
</Layout>
