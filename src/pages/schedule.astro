---
import Layout from '../layouts/Layout.astro';

const days = ['Lun', 'Mar', 'Mié', 'Jue', 'Vie', 'Sáb', 'Dom'];
const daysFull = ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado', 'Domingo'];

const slots: string[] = [];
for (let h = 6; h < 22; h++) {
  slots.push(`${String(h).padStart(2, '0')}:00`);
  slots.push(`${String(h).padStart(2, '0')}:30`);
}
---
<Layout title="Horario de vuelo" eyebrow="Plan semanal">
  <section class="intro">
    <h1>Horario de vuelo</h1>
    <p>Agrega clases, laboratorios o cualquier actividad semanal recurrente.</p>
  </section>

  <!-- ── Fechas importantes ─────────────────────────────────────────── -->
  <section class="deadlines-section">
    <h2>Fechas importantes</h2>
    <p class="deadlines-sub">Exámenes, entregas, pruebas de motor, lo que sea.</p>

    <form id="deadline-form" class="deadline-form panel">
      <input id="deadline-label" type="text" placeholder="ej. Examen de termodinámica" required />
      <div class="deadline-form-row">
        <input id="deadline-date" type="date" required />
        <input id="deadline-time" type="time" />
        <button type="submit" class="btn btn-flame">Agregar</button>
      </div>
    </form>

    <ul id="deadline-list" class="deadline-list"></ul>
  </section>

  <!-- ── Horario semanal ────────────────────────────────────────────── -->
  <h2 class="schedule-title">Horario semanal</h2>

  <form id="event-form" class="event-form panel">
    <input id="ev-name" type="text" placeholder="Nombre — ej. Cálculo II" required />
    <div class="event-form-row">
      <select id="ev-day">
        {days.map((d, i) => <option value={i}>{d}</option>)}
      </select>
      <div class="time-pair">
        <select id="ev-start">
          {slots.map(s => <option value={s}>{s}</option>)}
        </select>
        <span class="mono time-sep">→</span>
        <select id="ev-end">
          {slots.map(s => <option value={s}>{s}</option>)}
        </select>
      </div>
      <input id="ev-color" type="color" value="#4ea8ff" title="Color" />
      <button type="submit" class="btn btn-flame">Añadir</button>
    </div>
  </form>

  <!-- ── Vista por día (solo móvil) ────────────────────────────────── -->
  <div class="day-view" id="day-view">
    <div class="day-tabs" id="day-tabs" role="tablist">
      {days.map((d, i) => (
        <button class="day-tab" data-day={i} type="button" role="tab">{d}</button>
      ))}
    </div>
    <div class="day-title-row">
      <span class="day-title-label mono" id="day-title-label"></span>
    </div>
    <div class="day-events" id="day-events"></div>
  </div>

  <!-- ── Tabla semanal (solo desktop) ──────────────────────────────── -->
  <div class="table-section">
    <div class="table-wrap panel">
      <table id="schedule-table">
        <thead>
          <tr>
            <th class="corner mono">Hora</th>
            {days.map(d => <th class="mono">{d}</th>)}
          </tr>
        </thead>
        <tbody>
          {slots.map(slot => (
            <tr>
              <td class="hour-label mono">{slot}</td>
              {days.map((_, di) => (
                <td class="cell" data-slot={slot} data-day={String(di)}></td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>

  <script define:vars={{ daysFull }}>
    import { getItem, setItem } from '../lib/store';

    const EVENT_KEY    = 'acm.weeklyEvents';
    const DEADLINE_KEY = 'acm.deadlines';

    let events    = [];
    let deadlines = [];

    // ── helpers ───────────────────────────────────────────────────────
    function toMinutes(t) {
      const [h, m] = t.split(':').map(Number);
      return h * 60 + m;
    }
    function slotInEvent(slot, ev) {
      return toMinutes(slot) >= toMinutes(ev.start) && toMinutes(slot) < toMinutes(ev.end);
    }
    function slotIsStart(slot, ev) { return slot === ev.start; }

    // ── desktop grid ──────────────────────────────────────────────────
    function renderGrid() {
      document.querySelectorAll('.cell').forEach(cell => {
        const slot = cell.dataset.slot;
        const day  = Number(cell.dataset.day);
        cell.innerHTML = '';
        cell.style.cssText = '';
        cell.removeAttribute('data-event-id');

        const ev = events.find(e => e.day === day && slotInEvent(slot, e));
        if (!ev) return;

        const alpha = slotIsStart(slot, ev) ? '33' : '22';
        cell.style.background   = ev.color + alpha;
        cell.style.borderLeft   = `3px solid ${ev.color}`;
        cell.style.borderBottom = `1px solid ${ev.color}44`;
        cell.dataset.eventId    = ev.id;

        if (slotIsStart(slot, ev)) {
          const label = document.createElement('span');
          label.className   = 'ev-label';
          label.textContent = ev.name;
          label.style.color = ev.color;
          cell.appendChild(label);

          const del = document.createElement('button');
          del.className   = 'ev-del';
          del.textContent = '✕';
          del.title       = 'Eliminar evento';
          del.onclick = (e) => {
            e.stopPropagation();
            events = events.filter(x => x.id !== ev.id);
            void setItem(EVENT_KEY, events);
            renderGrid();
            renderDayView();
          };
          cell.appendChild(del);
        }
      });
    }

    // ── mobile day view ───────────────────────────────────────────────
    let selectedDay = (new Date().getDay() + 6) % 7; // JS 0=Sun → our 0=Mon

    function renderDayView() {
      const container = document.getElementById('day-events');
      const titleEl   = document.getElementById('day-title-label');
      if (!container || !titleEl) return;

      titleEl.textContent = daysFull[selectedDay];

      const dayEvents = events
        .filter(e => e.day === selectedDay)
        .sort((a, b) => toMinutes(a.start) - toMinutes(b.start));

      if (dayEvents.length === 0) {
        container.innerHTML = '<p class="day-empty mono">Sin clases este día.</p>';
        return;
      }

      container.innerHTML = '';
      dayEvents.forEach(ev => {
        const card = document.createElement('div');
        card.className = 'day-event-card';
        card.style.borderLeftColor = ev.color;
        card.style.background = ev.color + '18';

        card.innerHTML = `
          <div class="day-event-time mono">${ev.start} → ${ev.end}</div>
          <div class="day-event-name">${ev.name}</div>
          <button class="day-event-del" type="button" aria-label="Eliminar">✕</button>
        `;
        card.querySelector('.day-event-del').addEventListener('click', () => {
          events = events.filter(x => x.id !== ev.id);
          void setItem(EVENT_KEY, events);
          renderGrid();
          renderDayView();
        });
        container.appendChild(card);
      });
    }

    // Day tabs
    function setActiveTab(day) {
      selectedDay = day;
      document.querySelectorAll('.day-tab').forEach((btn, i) => {
        btn.classList.toggle('active', i === day);
      });
      renderDayView();
    }

    document.querySelectorAll('.day-tab').forEach((btn, i) => {
      btn.addEventListener('click', () => setActiveTab(i));
    });
    setActiveTab(selectedDay);

    // ── event form ────────────────────────────────────────────────────
    const evForm  = document.getElementById('event-form');
    const evStart = document.getElementById('ev-start');
    const evEnd   = document.getElementById('ev-end');

    evStart.addEventListener('change', () => {
      const startMin = toMinutes(evStart.value);
      Array.from(evEnd.options).forEach(opt => {
        opt.disabled = toMinutes(opt.value) <= startMin;
      });
      if (toMinutes(evEnd.value) <= startMin) {
        const next = Array.from(evEnd.options).find(o => !o.disabled);
        if (next) evEnd.value = next.value;
      }
    });
    evStart.dispatchEvent(new Event('change'));

    evForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const name  = document.getElementById('ev-name').value.trim();
      const day   = Number(document.getElementById('ev-day').value);
      const start = evStart.value;
      const end   = evEnd.value;
      const color = document.getElementById('ev-color').value;
      if (!name || toMinutes(end) <= toMinutes(start)) return;
      events.push({ id: crypto.randomUUID(), name, day, start, end, color });
      void setItem(EVENT_KEY, events);
      renderGrid();
      // Switch to the added day in mobile view
      setActiveTab(day);
      document.getElementById('ev-name').value = '';
    });

    // ── deadlines ─────────────────────────────────────────────────────
    function daysUntil(dateStr) {
      const target = new Date(dateStr + 'T00:00:00').getTime();
      const today  = new Date(); today.setHours(0,0,0,0);
      return Math.ceil((target - today.getTime()) / 86_400_000);
    }
    function countdownLabel(days) {
      if (days < 0)  return `hace ${Math.abs(days)} día${Math.abs(days) === 1 ? '' : 's'}`;
      if (days === 0) return '¡hoy!';
      if (days === 1) return 'mañana';
      return `en ${days} días`;
    }

    function renderDeadlines() {
      const list = document.getElementById('deadline-list');
      list.innerHTML = '';
      const sorted = [...deadlines].sort((a, b) => a.date.localeCompare(b.date));
      if (sorted.length === 0) {
        list.innerHTML = '<li class="mono deadline-empty">Sin fechas todavía.</li>';
        return;
      }
      for (const d of sorted) {
        const days    = daysUntil(d.date);
        const isPast  = days < 0;
        const isUrgent = days >= 0 && days <= 3;
        const li = document.createElement('li');
        li.className = 'deadline-item' + (isPast ? ' past' : '') + (isUrgent && !isPast ? ' urgent' : '');
        li.innerHTML = `
          <div class="dl-left">
            <span class="dl-label">${d.label}</span>
            <span class="dl-meta mono">${d.date}${d.time ? ' · ' + d.time : ''}</span>
          </div>
          <span class="dl-countdown mono">${countdownLabel(days)}</span>
          <button class="dl-del" type="button" aria-label="Eliminar">✕</button>
        `;
        li.querySelector('button').addEventListener('click', () => {
          deadlines = deadlines.filter(x => x.id !== d.id);
          void setItem(DEADLINE_KEY, deadlines);
          renderDeadlines();
        });
        list.appendChild(li);
      }
    }

    const dlForm = document.getElementById('deadline-form');
    dlForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const label = document.getElementById('deadline-label');
      const date  = document.getElementById('deadline-date');
      const time  = document.getElementById('deadline-time');
      if (!label.value.trim() || !date.value) return;
      deadlines.push({ id: crypto.randomUUID(), label: label.value.trim(), date: date.value, time: time.value || undefined });
      void setItem(DEADLINE_KEY, deadlines);
      label.value = date.value = time.value = '';
      renderDeadlines();
    });

    // ── init ──────────────────────────────────────────────────────────
    async function init() {
      events    = await getItem(EVENT_KEY, []);
      deadlines = await getItem(DEADLINE_KEY, []);
      renderGrid();
      renderDayView();
      renderDeadlines();
    }
    init();
    window.addEventListener('acm:auth', (e) => {
      if (e.detail?.authenticated) init();
    });
  </script>

  <style>
    .intro { padding: 24px 0 4px; max-width: 60ch; }
    .intro h1 { font-size: 1.8rem; margin-bottom: 10px; }
    .intro p { color: var(--ink-dim); }

    /* ── Deadline form ──────────────────────────────────────────────── */
    .deadlines-section { margin-bottom: 40px; }
    .deadlines-section h2 { font-size: 1.2rem; margin-bottom: 6px; }
    .deadlines-sub { color: var(--ink-dim); font-size: 0.85rem; margin-bottom: 16px; }

    .deadline-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 16px;
      margin-bottom: 20px;
    }
    .deadline-form input[type="text"] { width: 100%; }
    .deadline-form-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }
    .deadline-form-row input { flex: 1 1 130px; }
    .deadline-form-row .btn { flex-shrink: 0; }

    /* ── Event form ─────────────────────────────────────────────────── */
    .schedule-title { font-size: 1.2rem; margin: 0 0 16px; }

    .event-form {
      display: flex;
      flex-direction: column;
      gap: 10px;
      padding: 16px;
      margin: 0 0 24px;
    }
    .event-form input[type="text"] { width: 100%; }
    .event-form-row {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      align-items: center;
    }
    .time-pair { display: flex; align-items: center; gap: 6px; flex-shrink: 0; }
    .time-sep { color: var(--ink-dim); font-size: 0.8rem; }
    #ev-color {
      width: 38px; height: 38px; padding: 2px;
      border-radius: 6px; border: 1px solid var(--panel-line);
      background: none; cursor: pointer; flex-shrink: 0;
    }

    /* ── Mobile day view ────────────────────────────────────────────── */
    .day-view { display: none; margin-bottom: 40px; }

    .day-tabs {
      display: flex;
      gap: 6px;
      overflow-x: auto;
      padding-bottom: 4px;
      margin-bottom: 16px;
      scrollbar-width: none;
    }
    .day-tabs::-webkit-scrollbar { display: none; }

    .day-tab {
      font-family: var(--font-mono);
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      padding: 10px 16px;
      border-radius: 999px;
      border: 1px solid var(--panel-line);
      background: var(--void-2);
      color: var(--ink-dim);
      cursor: pointer;
      white-space: nowrap;
      flex-shrink: 0;
      touch-action: manipulation;
      transition: color 0.15s, border-color 0.15s, background 0.15s;
    }
    .day-tab.active {
      color: var(--void);
      background: var(--telemetry);
      border-color: var(--telemetry);
      font-weight: 700;
    }

    .day-title-row { margin-bottom: 12px; }
    .day-title-label {
      font-size: 0.72rem;
      color: var(--ink-dim);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .day-events { display: flex; flex-direction: column; gap: 10px; }
    .day-empty { color: var(--ink-dim); font-size: 0.82rem; padding: 20px 0; text-align: center; }

    .day-event-card {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 16px 18px;
      border: 1px solid var(--panel-line);
      border-left: 4px solid;
      border-radius: var(--radius-sm);
      position: relative;
    }
    .day-event-time {
      font-size: 0.72rem;
      color: var(--ink-dim);
      white-space: nowrap;
      flex-shrink: 0;
    }
    .day-event-name {
      font-size: 0.95rem;
      font-weight: 600;
      color: var(--ink);
      flex: 1;
      min-width: 0;
    }
    .day-event-del {
      background: none;
      border: none;
      color: var(--ink-dim);
      cursor: pointer;
      font-size: 0.75rem;
      padding: 8px;
      border-radius: 6px;
      touch-action: manipulation;
      flex-shrink: 0;
      min-width: 36px;
      min-height: 36px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .day-event-del:active { color: var(--flame); }

    /* ── Desktop table ──────────────────────────────────────────────── */
    .table-section { display: block; }
    .table-wrap {
      margin: 0 0 40px;
      overflow-x: auto;
      padding: 8px;
    }
    table { border-collapse: collapse; width: 100%; min-width: 640px; }
    th, td { padding: 4px 8px; text-align: left; border: 1px solid var(--panel-line); }
    th { font-size: 0.68rem; color: var(--ink-dim); text-transform: uppercase; letter-spacing: 0.05em; background: var(--void-2); }
    .corner { color: var(--telemetry); }
    .hour-label { font-size: 0.65rem; color: var(--ink-dim); white-space: nowrap; width: 48px; }
    .cell {
      height: 28px; min-width: 90px;
      vertical-align: top; position: relative;
      transition: background 0.1s;
    }
    .cell:hover { background: rgba(255,255,255,0.03); }

    :global(.ev-label) {
      display: block; font-size: 0.7rem; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      padding: 4px 22px 0 4px; line-height: 1.2;
    }
    :global(.ev-del) {
      position: absolute; top: 3px; right: 3px;
      background: rgba(0,0,0,0.3); border: none;
      color: rgba(255,255,255,0.5); border-radius: 50%;
      width: 20px; height: 20px; font-size: 0.55rem;
      cursor: pointer; display: none;
      align-items: center; justify-content: center; line-height: 1;
    }
    :global(.cell:hover .ev-del) { display: flex; }
    :global(.ev-del:hover) { background: rgba(0,0,0,0.6); color: #fff; }

    /* ── Deadline list ──────────────────────────────────────────────── */
    .deadline-list {
      list-style: none; padding: 0; margin: 0;
      display: flex; flex-direction: column; gap: 10px;
    }
    :global(.deadline-item) {
      display: flex; align-items: center; gap: 14px;
      padding: 14px 16px;
      background: var(--panel);
      border: 1px solid var(--panel-line);
      border-left: 3px solid var(--telemetry);
      border-radius: var(--radius-sm);
    }
    :global(.deadline-item.past) { opacity: 0.4; border-left-color: var(--panel-line); }
    :global(.deadline-item.urgent) { border-left-color: var(--flame); background: rgba(255,107,53,0.06); }
    :global(.dl-left) { display: flex; flex-direction: column; gap: 3px; flex: 1; min-width: 0; }
    :global(.dl-label) { font-size: 0.92rem; font-weight: 600; color: var(--ink); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    :global(.dl-meta) { font-size: 0.7rem; color: var(--ink-dim); }
    :global(.dl-countdown) {
      font-family: var(--font-mono); font-size: 0.7rem;
      color: var(--telemetry); background: rgba(95,212,208,0.1);
      padding: 3px 10px; border-radius: 999px; white-space: nowrap; flex-shrink: 0;
    }
    :global(.deadline-item.urgent .dl-countdown) { color: var(--flame); background: rgba(255,107,53,0.15); }
    :global(.deadline-item.past .dl-countdown) { color: var(--ink-dim); background: var(--void-2); }
    :global(.dl-del) {
      background: none; border: none; color: var(--ink-dim); cursor: pointer;
      font-size: 0.7rem; border-radius: 4px; opacity: 0; transition: opacity 0.15s;
      touch-action: manipulation; min-width: 32px; min-height: 32px;
      display: flex; align-items: center; justify-content: center;
    }
    :global(.deadline-item:hover .dl-del) { opacity: 1; }
    :global(.dl-del:hover) { color: var(--flame); }
    .deadline-empty { color: var(--ink-dim); font-size: 0.8rem; padding: 8px 0; }

    /* ── Responsive breakpoint ──────────────────────────────────────── */
    @media (max-width: 700px) {
      .day-view { display: block; }
      .table-section { display: none; }

      /* Show dl-del always on touch */
      :global(.dl-del) { opacity: 1; }

      .event-form-row { flex-direction: column; align-items: stretch; }
      .event-form-row select,
      .event-form-row .btn { width: 100%; }
      .time-pair { flex-wrap: wrap; }
      #ev-color { width: 44px; height: 44px; }
    }
  </style>
</Layout>
