---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  eyebrow?: string;
}
const { title, eyebrow } = Astro.props;
const nav = [
  { href: '/', label: 'Centro de mando' },
  { href: '/board', label: 'Tablero de misión' },
  { href: '/schedule', label: 'Horario de vuelo' },
  { href: '/timer', label: 'Cuenta regresiva' },
  { href: '/notes', label: 'Paquete de apoyo' },
];
const path = Astro.url.pathname;
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="description" content="Centro de mando personal de Alexandra — misiones, horario y motivación." />
    <meta name="theme-color" content="#4ea8ff" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="ACM" />
    <title>{title} · Centro de Mando</title>
  </head>
  <body>
    <header class="topbar">
      <div class="wrap topbar-inner">
        <a href="/" class="brand">
          <span class="brand-mark">✦</span>
          <span class="brand-text">
            <span class="brand-line1">CENTRO DE MANDO</span>
            <span class="brand-line2" id="brand-name">Centro de Mando</span>
          </span>
        </a>
        <div class="nav-end">
          <nav class="nav" aria-label="Navegación principal">
            {nav.map((item) => (
              <a href={item.href} class:list={['nav-link', { active: path === item.href }]}>
                {item.label}
              </a>
            ))}
          </nav>
          <button id="logout-btn" class="logout-btn mono hidden" type="button">Cerrar sesión</button>
        </div>
        <button class="hamburger" id="hamburger-btn" aria-label="Abrir menú" aria-expanded="false" type="button">
          <span></span>
          <span></span>
          <span></span>
        </button>
      </div>
    </header>

    <!-- Full-screen mobile nav overlay -->
    <div class="mobile-overlay" id="mobile-nav" aria-hidden="true" role="dialog" aria-modal="true" aria-label="Menú">
      <div class="mobile-overlay-inner">
        <nav class="mobile-overlay-nav">
          {nav.map((item) => (
            <a href={item.href} class:list={['mobile-overlay-link', { active: path === item.href }]}>
              <span class="mobile-overlay-link-num">✦</span>
              {item.label}
            </a>
          ))}
        </nav>
        <button id="mobile-logout-btn" class="mobile-logout-btn mono hidden" type="button">Cerrar sesión</button>
      </div>
    </div>

    <div id="auth-gate" class="auth-gate hidden">
      <div class="auth-card panel">
        <span class="eyebrow">Acceso</span>
        <h2 id="auth-title">Inicia sesión</h2>
        <form id="auth-form" class="auth-form">
          <input id="auth-email" type="email" placeholder="tu@correo.com" required autocomplete="email" />
          <input id="auth-password" type="password" placeholder="contraseña" required autocomplete="current-password" minlength="6" />
          <button type="submit" class="btn btn-flame" id="auth-submit">Entrar</button>
        </form>
        <p id="auth-status" class="mono auth-status"></p>
        <p class="auth-toggle-text">
          <span id="auth-toggle-label">¿No tienes cuenta?</span>
          <button type="button" id="auth-toggle" class="auth-toggle-btn">Crear cuenta</button>
        </p>
      </div>
    </div>

    <!-- Name prompt modal -->
    <div id="name-modal" class="name-modal hidden">
      <div class="name-card panel">
        <span class="eyebrow">Bienvenido/a</span>
        <h2>¿Cómo te llamas?</h2>
        <p class="auth-copy">Este nombre aparecerá en tu Centro de Mando.</p>
        <form id="name-form" class="auth-form">
          <input id="name-input" type="text" placeholder="Tu nombre" required autocomplete="name" />
          <button type="submit" class="btn btn-flame">Guardar y entrar</button>
        </form>
      </div>
    </div>

    <main class="wrap main hidden" id="app-content">
      <slot />
    </main>

    <script>
      import { supabase, isSupabaseConfigured } from '../lib/supabase';
      import { getItem, setItem } from '../lib/store';

      const gate            = document.getElementById('auth-gate')!;
      const content         = document.getElementById('app-content')!;
      const logoutBtn       = document.getElementById('logout-btn')!;
      const mobileLogoutBtn = document.getElementById('mobile-logout-btn')!;
      const form            = document.getElementById('auth-form') as HTMLFormElement;
      const statusEl        = document.getElementById('auth-status')!;
      const nameModal       = document.getElementById('name-modal')!;
      const nameForm        = document.getElementById('name-form') as HTMLFormElement;
      const brandName       = document.getElementById('brand-name')!;

      // Hamburger menu overlay
      const hamburgerBtn = document.getElementById('hamburger-btn')!;
      const mobileNav    = document.getElementById('mobile-nav')!;

      function openMenu() {
        mobileNav.classList.add('open');
        hamburgerBtn.classList.add('open');
        hamburgerBtn.setAttribute('aria-expanded', 'true');
        mobileNav.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function closeMenu() {
        mobileNav.classList.remove('open');
        hamburgerBtn.classList.remove('open');
        hamburgerBtn.setAttribute('aria-expanded', 'false');
        mobileNav.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
      }

      hamburgerBtn.addEventListener('click', () => {
        mobileNav.classList.contains('open') ? closeMenu() : openMenu();
      });
      mobileNav.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));
      // close on backdrop tap
      mobileNav.addEventListener('click', (e) => {
        if (e.target === mobileNav) closeMenu();
      });

      async function loadAndSetName() {
        const profile = await getItem<{ name: string } | null>('acm.profile', null);
        if (profile?.name) {
          brandName.textContent = `${profile.name} · Centro de Mando`;
        } else {
          // account exists but no name set — show name modal
          nameModal.classList.remove('hidden');
        }
      }

      async function saveName(name: string) {
        await setItem('acm.profile', { name });
        brandName.textContent = `${name} · Centro de Mando`;
        nameModal.classList.add('hidden');
      }

      nameForm.addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = (document.getElementById('name-input') as HTMLInputElement).value.trim();
        if (!name) return;
        await saveName(name);
      });

      function showApp() {
        gate.classList.add('hidden');
        content.classList.remove('hidden');
        logoutBtn.classList.remove('hidden');
        mobileLogoutBtn.classList.remove('hidden');
        window.dispatchEvent(new CustomEvent('acm:auth', { detail: { authenticated: true } }));
        loadAndSetName();
      }

      function showGate(message?: string) {
        content.classList.add('hidden');
        gate.classList.remove('hidden');
        nameModal.classList.add('hidden');
        logoutBtn.classList.add('hidden');
        mobileLogoutBtn.classList.add('hidden');
        brandName.textContent = 'Centro de Mando';
        if (message) statusEl.textContent = message;
        window.dispatchEvent(new CustomEvent('acm:auth', { detail: { authenticated: false } }));
      }

      if (!isSupabaseConfigured) {
        showGate('Supabase todavía no está configurado (faltan PUBLIC_SUPABASE_URL / PUBLIC_SUPABASE_ANON_KEY).');
        form.querySelector('button')!.setAttribute('disabled', 'true');
      } else {
        supabase.auth.getSession().then(({ data }) => {
          if (data.session) showApp();
          else showGate();
        });

        supabase.auth.onAuthStateChange((_event, session) => {
          if (session) showApp();
          else showGate();
        });

        let isSignUp = false;
        let pendingName = false;

        const title       = document.getElementById('auth-title')!;
        const submitBtn   = document.getElementById('auth-submit')!;
        const toggleBtn   = document.getElementById('auth-toggle')!;
        const toggleLabel = document.getElementById('auth-toggle-label')!;
        const passwordInput = document.getElementById('auth-password') as HTMLInputElement;

        toggleBtn.addEventListener('click', () => {
          isSignUp = !isSignUp;
          title.textContent         = isSignUp ? 'Crear cuenta' : 'Inicia sesión';
          submitBtn.textContent     = isSignUp ? 'Crear cuenta' : 'Entrar';
          toggleLabel.textContent   = isSignUp ? '¿Ya tienes cuenta?' : '¿No tienes cuenta?';
          toggleBtn.textContent     = isSignUp ? 'Inicia sesión' : 'Crear cuenta';
          passwordInput.autocomplete = isSignUp ? 'new-password' : 'current-password';
          statusEl.textContent = '';
        });

        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const email    = (document.getElementById('auth-email') as HTMLInputElement).value.trim();
          const password = passwordInput.value;
          if (!email || !password) return;

          statusEl.textContent = isSignUp ? 'Creando cuenta…' : 'Entrando…';
          submitBtn.setAttribute('disabled', 'true');

          if (isSignUp) {
            pendingName = true;
            const { error } = await supabase.auth.signUp({ email, password });
            if (error) {
              statusEl.textContent = `Error: ${error.message}`;
              pendingName = false;
            }
            // showApp() will be triggered by onAuthStateChange → loadAndSetName → shows modal
          } else {
            const { error } = await supabase.auth.signInWithPassword({ email, password });
            if (error) statusEl.textContent = `Error: ${error.message}`;
          }

          submitBtn.removeAttribute('disabled');
        });

        const signOut = async () => { await supabase.auth.signOut(); };
        logoutBtn.addEventListener('click', signOut);
        mobileLogoutBtn.addEventListener('click', signOut);
      }
    </script>

    <footer class="wrap footer">
      <p class="mono footer-text">T-MINUS SIEMPRE · hecho con cariño, para que despegues cada día 🚀</p>
    </footer>

    <Analytics />

    <style>
      .topbar {
        border-bottom: 1px solid var(--panel-line);
        background: rgba(11, 18, 32, 0.92);
        backdrop-filter: blur(10px);
        position: sticky;
        top: 0;
        z-index: 10;
      }
      .topbar-inner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding-top: 12px;
        padding-bottom: 12px;
        flex-wrap: nowrap;
      }
      .brand {
        display: flex;
        align-items: center;
        gap: 10px;
        text-decoration: none;
      }
      .brand-mark {
        color: var(--ion);
        font-size: 1.1rem;
      }
      .brand-text {
        display: flex;
        flex-direction: column;
        line-height: 1.2;
      }
      .brand-line1 {
        font-family: var(--font-display);
        font-weight: 700;
        font-size: 0.95rem;
        letter-spacing: 0.03em;
      }
      .brand-line2 {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        color: var(--ink-dim);
      }
      .nav-end {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
      }
      .nav {
        display: flex;
        gap: 2px;
        flex-wrap: nowrap;
      }
      .nav-link {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        letter-spacing: 0.02em;
        text-transform: uppercase;
        text-decoration: none;
        color: var(--ink-dim);
        padding: 6px 9px;
        border-radius: var(--radius-sm);
        border: 1px solid transparent;
        white-space: nowrap;
        transition: color 0.15s ease, border-color 0.15s ease, background 0.15s ease;
      }
      .nav-link:hover { color: var(--ink); border-color: var(--panel-line); }
      .nav-link.active {
        color: var(--telemetry);
        border-color: var(--panel-line);
        background: var(--panel);
      }

      /* Hamburger button — always hidden on desktop */
      .hamburger {
        display: none;
        flex-direction: column;
        justify-content: center;
        gap: 5px;
        background: none;
        border: 1px solid var(--panel-line);
        border-radius: var(--radius-sm);
        padding: 10px 11px;
        cursor: pointer;
        flex-shrink: 0;
        touch-action: manipulation;
        z-index: 110;
        position: relative;
      }
      .hamburger span {
        display: block;
        width: 18px;
        height: 2px;
        background: var(--ink-dim);
        transition: transform 0.25s ease, opacity 0.25s ease, background 0.25s ease;
      }
      .hamburger.open span { background: var(--ink); }
      .hamburger.open span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
      .hamburger.open span:nth-child(2) { opacity: 0; transform: scaleX(0); }
      .hamburger.open span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

      /* Full-screen mobile overlay */
      .mobile-overlay {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 100;
        background: rgba(11, 18, 32, 0.97);
        backdrop-filter: blur(16px);
        opacity: 0;
        transition: opacity 0.25s ease;
      }
      .mobile-overlay.open {
        display: flex;
        opacity: 1;
      }
      .mobile-overlay-inner {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: flex-start;
        width: 100%;
        padding: 80px 36px 60px;
        gap: 4px;
      }
      .mobile-overlay-nav {
        display: flex;
        flex-direction: column;
        width: 100%;
        gap: 2px;
        margin-bottom: 40px;
      }
      .mobile-overlay-link {
        display: flex;
        align-items: center;
        gap: 14px;
        font-family: var(--font-display);
        font-size: 1.6rem;
        font-weight: 600;
        text-decoration: none;
        color: var(--ink-dim);
        padding: 14px 0;
        border-bottom: 1px solid rgba(36, 49, 77, 0.4);
        transition: color 0.15s ease;
        touch-action: manipulation;
        letter-spacing: -0.01em;
      }
      .mobile-overlay-link:last-child { border-bottom: none; }
      .mobile-overlay-link.active { color: var(--ion); }
      .mobile-overlay-link:active { color: var(--telemetry); }
      .mobile-overlay-link-num {
        font-family: var(--font-mono);
        font-size: 0.7rem;
        color: var(--telemetry);
        opacity: 0.6;
      }
      .mobile-overlay-link.active .mobile-overlay-link-num { opacity: 1; }
      .mobile-logout-btn {
        font-family: var(--font-mono);
        font-size: 0.72rem;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        background: none;
        border: 1px solid var(--panel-line);
        color: var(--ink-dim);
        border-radius: var(--radius-sm);
        padding: 14px 20px;
        cursor: pointer;
        touch-action: manipulation;
        align-self: flex-start;
      }
      .mobile-logout-btn:active { color: var(--flame); border-color: var(--flame); }

      @media (max-width: 780px) {
        .nav-end { display: none; }
        .hamburger { display: flex; }
      }
      .page-eyebrow { padding-top: 28px; }
      .main {
        padding-top: 16px;
        padding-bottom: 80px;
        min-height: 60vh;
      }
      .hidden { display: none !important; }

      .logout-btn {
        font-size: 0.7rem;
        letter-spacing: 0.04em;
        text-transform: uppercase;
        background: none;
        border: 1px solid var(--panel-line);
        color: var(--ink-dim);
        border-radius: var(--radius-sm);
        padding: 7px 12px;
        cursor: pointer;
      }
      .logout-btn:hover { color: var(--flame); border-color: var(--flame); }

      .auth-gate {
        display: flex;
        justify-content: center;
        padding: 60px 24px 100px;
      }
      .auth-card {
        max-width: 420px;
        width: 100%;
        padding: 32px 28px;
        text-align: left;
      }
      .auth-card h2 { font-size: 1.3rem; margin: 10px 0 12px; }
      .auth-copy { color: var(--ink-dim); font-size: 0.88rem; margin-bottom: 20px; }
      .auth-form { display: flex; flex-direction: column; gap: 10px; }
      .auth-status { margin-top: 14px; font-size: 0.72rem; color: var(--telemetry); min-height: 1em; }
      .auth-toggle-text { margin-top: 16px; font-size: 0.78rem; color: var(--ink-dim); }
      .auth-toggle-btn { background: none; border: none; color: var(--ion); cursor: pointer; font-size: 0.78rem; padding: 0; text-decoration: underline; }
      .auth-toggle-btn:hover { color: var(--telemetry); }

      .name-modal {
        position: fixed;
        inset: 0;
        background: rgba(11, 18, 32, 0.85);
        backdrop-filter: blur(6px);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 50;
        padding: 24px;
      }
      .name-modal.hidden { display: none !important; }
      .name-card {
        max-width: 400px;
        width: 100%;
        padding: 32px 28px;
      }
      .name-card h2 { font-size: 1.3rem; margin: 10px 0 12px; }
      .name-card .auth-copy { color: var(--ink-dim); font-size: 0.88rem; margin-bottom: 20px; }
      .footer {
        border-top: 1px solid var(--panel-line);
        padding-top: 20px;
        padding-bottom: 32px;
      }
      .footer-text {
        font-size: 0.72rem;
        color: var(--ink-dim);
        text-align: center;
        letter-spacing: 0.05em;
      }
    </style>
  </body>
</html>
